# fleetmem service config — copy to `brain.env` and edit for your environment.
# Loaded by systemd EnvironmentFile= into the gunicorn env. Code keeps each of these as a
# fallback default, so a missing/partial file cannot down the service. Edit THIS file instead
# of the code. Ports live in the systemd units, not here. NO secrets belong here (DB uses local
# peer auth; agent tokens/certs are minted at enrollment, never stored in this file).
PGDATABASE=brain
# force UTF-8 client encoding (safe on any host locale; systemd EnvironmentFile has no inline comments)
PGCLIENTENCODING=UTF8

# --- Local LLM endpoints (point these at your Ollama or compatible server) ---
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
EMBED_MODEL=bge-m3
OLLAMA_GEN_URL=http://127.0.0.1:11434/api/generate
RERANK_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# EXTRACT_MODEL is consumed by autolearn/extract.py.
EXTRACT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# --- Tunable knobs ( inventory). Each line is the CODE DEFAULT; uncomment + change to override. ---
# Retrieval / recall
# EMBED_MAX_CHARS=6000          # client-side truncate before bge-m3 (~2048-tok ctx)
# RECALL_K=5                    # default recall depth (top-k)
# RECALL_POOL=20                # per-arm candidate pool before RRF fusion
# RELATED_CAP=3                 # how many 1-hop "related" notes recall appends
# RERANK_TIMEOUT=3              # LLM-rerank cold-load guard (seconds)
# EMBED_TIMEOUT=60              # hot-path embed call timeout (seconds)
# ENTITY_IP_PREFIXES=           # comma-sep dotted IP prefixes (e.g. 10.0.0.) to treat as recall
#                               # entities; empty = none. A private site sets its own subnet(s) here.
# Synthesis
# DEEP_BODY_CAP=2200            # per-source body chars sent to the deep-search synthesiser
# Policy / lifecycle
# ENROLL_APPROVALS=2            # distinct manager approvals to enroll an agent — SET TO 1 on a single-manager box
# PROVISIONAL_TTL_DAYS=14       # provisional-note expiry (days)
# ATTACH_MAX_MB=20              # per-attachment size ceiling (MB)
# Autolearn / extraction (scale with EXTRACT_MODEL's context window)
# EXTRACT_MAX_PROMPT_CHARS=24000
# EXTRACT_SPAN_CAP=600          # per-span text cap fed to the extractor
# Retention prune (prune_retention.py, daily timer) — 0 = keep forever
# ACTION_LOG_RETENTION_DAYS=365     # audit log
# SESSION_RECALL_RETENTION_DAYS=180 # recall-usage log
# SESSION_TURN_RETENTION_DAYS=365   # ingested transcript turns; keeps the session row as a tombstone
#                                   # and never prunes a session a live memory still links to
# ATTACHMENT_RETENTION_DAYS=30      # reclaim attachment blobs once their anchor memory (or the
#                                   # attachment itself) has been soft-deleted longer than this restore
#                                   # window; a restore within the window keeps them. 0 = keep forever
# Validate-on-recall backstop sweep (validate_sweep.py, daily timer)
# VALIDATE_SWEEP_DELETE=1       # 1 = soft-delete an untrusted note whose source transcript was provably pruned; 0 = census-only
