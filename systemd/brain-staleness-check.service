[Unit]
Description=Brain: project-plan staleness nudge — flag resume-here trailing task activity + manager alert
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brain
WorkingDirectory=/opt/brain-db/db
EnvironmentFile=-/opt/brain-db/db/brain.env
ExecStart=/usr/bin/python3 /opt/brain-db/db/staleness_check.py
