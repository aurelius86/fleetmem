[Unit]
Description=Brain: Ed25519 signature tamper check + manager alert
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brain
WorkingDirectory=/opt/brain-db/db
EnvironmentFile=-/opt/brain-db/db/brain.env
ExecStart=/usr/bin/python3 /opt/brain-db/db/run_memory_verify.py
