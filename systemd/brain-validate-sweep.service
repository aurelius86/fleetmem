[Unit]
Description=Brain: validate-on-recall backstop sweep — census of untrusted notes + source-gone-delete
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=brain
WorkingDirectory=/opt/brain-db/db
EnvironmentFile=-/opt/brain-db/db/brain.env
ExecStart=/usr/bin/python3 /opt/brain-db/db/validate_sweep.py
